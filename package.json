{
  "name": "@schie/fluent-zpl",
  "version": "1.0.0",
  "description": "A fluent interface for building ZPL (Zebra Programming Language) commands in TypeScript.",
  "repository": {
    "type": "git",
    "url": "https://github.com/schie/fluent-zpl.git"
  },
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "docs": "typedoc",
    "docs:pages": "pnpm run docs && pnpm run examples:build && rm -rf docs/examples && cp -R examples/dist docs/examples",
    "docs:serve": "pnpm dlx http-server docs",
    "examples:dev": "pnpm --filter examples run dev",
    "examples:build": "pnpm --filter examples run build",
    "examples:preview": "pnpm --filter examples run preview"
  },
  "author": {
    "name": "Dustin Schie",
    "email": "github@schie.io",
    "url": "https://github.com/schie"
  },
  "license": "MIT",
  "keywords": [
    "ZPL",
    "zebra",
    "printer",
    "labels",
    "rfid",
    "typescript",
    "fluent",
    "builder"
  ],
  "homepage": "https://github.com/schie/fluent-zpl#readme",
  "bugs": {
    "url": "https://github.com/schie/fluent-zpl/issues"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.6",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "neostandard": "^0.12.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.3.4",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "validate-conventional-commit": "^1.0.4"
  },
  "lint-staged": {
    "**/*.{js,json}": [
      "pnpm run lint:fix"
    ]
  }
}
